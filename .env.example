# =============================================================================
# Apex — environment variables (ROOT SUMMARY)
# =============================================================================
# Copy the relevant blocks into the per-app env files and fill them in:
#   - apps/api/.env   (backend secrets — NEVER commit, NEVER expose to browser)
#   - apps/web/.env   (frontend config — only VITE_* values, all public)
#
# See apps/api/.env.example and apps/web/.env.example for the authoritative,
# per-app templates. Real values live ONLY in Railway/host env vars.
# -----------------------------------------------------------------------------

# ---- Phase 1 (required now) -------------------------------------------------
# Postgres connection string (Railway provides this automatically).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/apex"
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# The exact origin of the web app, used to lock down CORS + cookies.
APP_ORIGIN="http://localhost:5173"
# Seed-only: the single user created on first `db:seed`. Change password in-app after.
ADMIN_EMAIL="you@example.com"
ADMIN_INITIAL_PASSWORD="change-me-on-first-login"
# Port the API listens on (Railway sets PORT automatically).
PORT="8080"
NODE_ENV="development"

# ---- Frontend (apps/web/.env) ----------------------------------------------
# Base URL the PWA calls. Public value (safe to expose).
VITE_API_URL="http://localhost:8080"

# ---- Later phases (leave unset until we get there) --------------------------
# ANTHROPIC_API_KEY=""          # Phase 4 — AI briefing, macro estimate, tips
# HEVY_API_KEY=""               # Phase 3 — auto workout import (read-only)
# NOTION_TOKEN=""               # Phase 3 — Twinly expenses
# NOTION_EXPENSES_DB_ID="5de30779-8408-455c-8c4d-525ed00bc4a1"
# HEALTH_INGEST_TOKEN=""        # Phase 3 — Apple Health bridge POST auth
# ENCRYPTION_KEY=""             # Phase 4 — encrypt bank statements / health at rest
# VAPID_PUBLIC_KEY=""           # Phase 5 — web push
# VAPID_PRIVATE_KEY=""          # Phase 5 — web push
# VAPID_SUBJECT="mailto:you@example.com"
# CF_ACCESS_TEAM_DOMAIN=""      # Optional — Cloudflare Access in front
# CF_ACCESS_AUD=""              # Optional — Cloudflare Access app audience tag
