// Apex data model.
// Phase 1 covers the single user, editable targets, and the fast-logging
// entities (meals, bodyweight, water, tasks). Later phases add workouts,
// health metrics, money/accounts, Twinly, and AI chat history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings     Settings?
  meals        Meal[]
  bodyweights  BodyweightEntry[]
  waterLogs    WaterLog[]
  tasks        Task[]
  goals             Goal[]
  habits            Habit[]
  workouts          Workout[]
  trainingPlan      TrainingPlan?
  accounts          Account[]
  netWorthSnapshots NetWorthSnapshot[]
  bills             Bill[]
  healthMetrics     HealthMetric[]
  twinlyExpenses    TwinlyExpense[]
  aiMessages        AiMessage[]
  aiConversations   AiConversation[]
  aiArtifacts       AiArtifact[]
  aiMemories        AiMemory[]
  twinlySales       TwinlySale[]
  businesses        Business[]
  bankStatements    BankStatement[]
  transactions      Transaction[]
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]
}

/// Editable recomp targets and preferences. One row per user.
model Settings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calorieTarget       Int      @default(2200)
  proteinTarget       Int      @default(155)
  fatTarget           Int      @default(60)
  carbTarget          Int      @default(260)
  waterTargetMl       Int      @default(3000)
  maintenanceCalories Int      @default(2600)
  heightCm            Int?     @default(174)
  weightUnit          String   @default("kg")
  // Phase 5 — push notification category toggles.
  notifyBills         Boolean  @default(true)
  notifyStreak        Boolean  @default(true)
  notifyLogging       Boolean  @default(true)
  aiInstructions      String? // user-written instructions injected into every AI feature
  activityStatus      String   @default("active") // active | sick | injured | break
  statusUntil         DateTime? // status auto-expires back to active after this (null = until changed)
  updatedAt           DateTime @updatedAt
}

model Meal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eatenAt     DateTime @default(now())
  source      String   @default("manual") // manual | text | photo | barcode
  description String
  calories    Int
  protein     Float
  carbs       Float
  fat         Float
  raw         Json? // raw AI / Open Food Facts payload, for later
  createdAt   DateTime @default(now())

  @@index([userId, eatenAt])
}

model BodyweightEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt DateTime @default(now())
  weightKg   Float
  source     String   @default("manual") // manual | watch
  createdAt  DateTime @default(now())

  @@index([userId, measuredAt])
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt  DateTime @default(now())
  amountMl  Int
  createdAt DateTime @default(now())

  @@index([userId, loggedAt])
}

model Task {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  notes      String?
  dueDate    DateTime?
  priority   Int        @default(2) // 1 high, 2 medium, 3 low
  color      String? // violet | blue | emerald | amber | rose | slate
  estMinutes Int? // estimated duration
  reminderLead Int? // minutes before dueDate to send a reminder (0 = at due time, null = off)
  repeat     String? // daily | weekdays | weekly — completing spawns the next occurrence
  actualMinutes Int? // accumulated focus-timer minutes
  timerStartedAt DateTime? // set while the focus timer is running
  done       Boolean    @default(false)
  doneAt     DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  steps      TaskStep[]

  @@index([userId, done, dueDate])
}

/// Ordered sub-steps of a task; the UI unlocks them one at a time.
model TaskStep {
  id        String    @id @default(cuid())
  taskId    String
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title      String
  estMinutes Int? // estimated duration for this step
  order      Int       @default(0)
  done       Boolean   @default(false)
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([taskId])
}

model Goal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  category     String    @default("personal")
  status       String    @default("active") // active | done | archived
  targetDate   DateTime
  // Optional numeric tracking
  metricUnit   String?
  startValue   Float?
  targetValue  Float?
  currentValue Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  milestones GoalMilestone[]

  @@index([userId, status])
}

model GoalMilestone {
  id        String    @id @default(cuid())
  goalId    String
  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  doneAt    DateTime?
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([goalId, done])
}

model Habit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  emoji     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  logs HabitLog[]

  @@index([userId, archived])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  day       String // local YYYY-MM-DD
  createdAt DateTime @default(now())

  @@unique([habitId, day])
}

model TrainingPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  days      String[] // 7 entries, Monday-first
  updatedAt DateTime @updatedAt
}

model Workout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  source      String   @default("manual") // manual | hevy
  externalId  String? // Hevy workout id, for dedupe on re-sync
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  sets WorkoutSet[]

  @@unique([userId, externalId])
  @@index([userId, performedAt])
}

model WorkoutSet {
  id        String   @id @default(cuid())
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise  String
  order     Int      @default(0)
  weightKg  Float?
  reps      Int?
  createdAt DateTime @default(now())

  @@index([workoutId])
}

// ---- Money -----------------------------------------------------------------

model Account {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  type       String     @default("cash") // cash | investment | other
  provider   String? // xcube | stashaway | manual
  balanceAed Float      @default(0)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  positions  Position[]

  @@index([userId])
}

/// Individual holdings inside an investment account (e.g. Aldar, Emaar).
model Position {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  valueAed  Float    @default(0)
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

model NetWorthSnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String // local YYYY-MM-DD
  totalAed  Float
  createdAt DateTime @default(now())

  @@unique([userId, day])
}

model Bill {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  amountAed   Float
  cadence     String   @default("monthly") // weekly | monthly | yearly | once
  nextDueDate DateTime
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, nextDueDate])
}

// ---- Apple Health ingest ----------------------------------------------------

model HealthMetric {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // steps | active_energy | resting_hr | heart_rate | sleep_hours | bodyweight
  value     Float
  unit      String?
  day       String // local YYYY-MM-DD for daily rollups
  startAt   DateTime
  endAt     DateTime?
  source    String    @default("apple_health")
  createdAt DateTime  @default(now())

  @@unique([userId, type, startAt])
  @@index([userId, type, day])
}

// ---- Twinly (Notion expenses cache) ----------------------------------------

model TwinlyExpense {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notionId  String    @unique
  title     String?
  category  String?
  amountAed Float
  date      DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, date])
}

// ---- Phase 4: AI coach ------------------------------------------------------

/// A chat thread with the coach; messages group under it.
model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("New chat")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

/// One short long-term memory line the AI keeps across every conversation
/// (saved by the agent from chat, or added by the user in the Memory sheet).
model AiMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  source    String   @default("user") // user | agent
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Cache for generated briefings / day plans / weekly reviews.
model AiArtifact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // briefing | plan | review:twinly | review:fitness | review:money
  key       String // e.g. day (YYYY-MM-DD) or week start
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, key])
}

/// A revenue-generating business the user runs (Twinly and others).
model Business {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sales     TwinlySale[]

  @@index([userId])
}

/// Daily sales for one business (manual entry).
model TwinlySale {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  day        String // local YYYY-MM-DD
  revenueAed Float    @default(0)
  orders     Int      @default(0)
  costAed    Float    @default(0)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, day])
  @@index([userId])
}

// ---- Phase 4: bank statements (encrypted at rest) ---------------------------

model BankStatement {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  month        String // YYYY-MM
  filename     String
  encryptedRaw String? // AES-256-GCM of the original text/CSV (PDFs not stored)
  summary      Json? // category totals, savings rate, tips (no raw descriptions)
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([userId, month])
}

model Transaction {
  id             String        @id @default(cuid())
  statementId    String
  statement      BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  day            String // YYYY-MM-DD
  descriptionEnc String // AES-256-GCM of the merchant/description
  amountAed      Float
  category       String
  kind           String        @default("debit") // debit | credit

  @@index([statementId])
  @@index([userId, day])
}

// ---- Phase 5: web push notifications ---------------------------------------

/// One row per browser/device push subscription (Web Push API).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Sent-notification log — dedupes reminders and powers an in-app history.
model NotificationLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // bill | streak | logging
  dedupeKey String // e.g. bill:<id>:<dueDay> or streak:<day>
  title     String
  body      String
  url       String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}
