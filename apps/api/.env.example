# =============================================================================
# apps/api/.env — backend secrets. NEVER commit. NEVER expose to the browser.
# Copy to apps/api/.env and fill in. On Railway, set these as service variables.
# =============================================================================

# Postgres. Railway injects this automatically when you add a Postgres plugin.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apex?schema=public"

# Session signing/encryption key. Must be >= 32 chars. Generate:
#   openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars-long"

# Exact origin of the PWA (locks CORS + cookies to your site only).
APP_ORIGIN="http://localhost:5173"

# API port. Railway sets PORT automatically; locally this defaults to 8080.
PORT="8080"
NODE_ENV="development"

# Seed-only credentials for the single user. Used by `npm run db:seed`.
# Change the password in-app after first login, then you can clear these.
ADMIN_EMAIL="you@example.com"
ADMIN_INITIAL_PASSWORD="change-me-on-first-login"

# ---- Phase 3: integrations (optional; each feature off until set) ----------
# HEVY_API_KEY=""
# NOTION_TOKEN=""
# NOTION_EXPENSES_DB_ID="5de30779-8408-455c-8c4d-525ed00bc4a1"
# HEALTH_INGEST_TOKEN=""
# WIDGET_TOKEN=""              # read-only token for the iOS home-screen widget

# ---- Phase 4: AI coach + encryption (optional) -----------------------------
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-4-8"
# 32-byte key for AES-256-GCM (bank statements). Generate: openssl rand -hex 32
# ENCRYPTION_KEY=""

# ---- Phase 5: web push notifications (optional) ----------------------------
# Generate a keypair: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
