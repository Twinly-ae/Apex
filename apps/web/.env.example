# apps/web/.env — frontend config. Only VITE_* vars; ALL are public (shipped to
# the browser). Never put secrets here.

# Base URL for API calls.
#  - Local dev: leave EMPTY and the Vite proxy forwards /api -> localhost:8080.
#  - Production: set to the API origin, e.g. https://api.apex.yourdomain.com
#    (or leave empty if you serve the API under the same origin via Cloudflare).
VITE_API_URL=""
